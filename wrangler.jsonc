// Cloudflare settings for the Ina Yoon fan page (yoonshine.com).
// The site is plain files, served as they are. No build step.
{
  "name": "yoonshine",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./"
  },
  // Serve the site only on its own domain. Without these lines every deploy would switch
  // the yoonshine.<account>.workers.dev address (and preview addresses) back on.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "yoonshine.com", "custom_domain": true },
    { "pattern": "www.yoonshine.com", "custom_domain": true }
  ]
}
